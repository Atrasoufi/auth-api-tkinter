# Django
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Frontend URL (used in password-reset email links)
FRONTEND_URL=http://localhost:5173

# Email — leave EMAIL_HOST empty to print emails to console (dev)
# For real SMTP (Gmail, Mailgun, SendGrid, etc.):
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@example.com

# Rate limiting
# Format: number/period  e.g. 5/hour, 10/day
THROTTLE_PASSWORD_RESET=5/hour
