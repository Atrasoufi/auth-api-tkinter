# Django
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web,0.0.0.0

# CORS (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Frontend URL (used in password-reset email links)
FRONTEND_URL=http://localhost:5173

# Email — leave EMAIL_HOST empty to print emails to console (dev)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@example.com

# Rate limiting
THROTTLE_PASSWORD_RESET=5/hour

# Postgres (used by docker-compose; leave POSTGRES_HOST empty for local SQLite)
POSTGRES_DB=scenario
POSTGRES_USER=scenario
POSTGRES_PASSWORD=scenario
# POSTGRES_HOST is set automatically inside Docker (db)
# For local Postgres without Docker, set:
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
